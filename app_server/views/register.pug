extends layout

block content
    .d-flex.justify-content-center.align-items-center(style="min-height: 85vh; padding: 20px;")
        div(style="width: 100%; max-width: 400px;")
            .custom-card
                h2.text-center.font-weight-bold.mb-1(style="color: #f5c518; font-size: 1.8rem; letter-spacing: -0.5px;")= pageHeader.title
                p.text-center.mb-4(style="color: #8c9ba5; font-size: 0.85rem;")= pageHeader.strapline

                if error
                    .alert.alert-danger.py-2.small.mb-3= error

                form(action="/register", method="post")
                    .form-group.mb-3
                        label.form-label-custom Name
                        input.form-control.custom-input(type="text", name="name", placeholder="Enter your full name", required)

                    .form-group.mb-3
                        label.form-label-custom Email
                        input.form-control.custom-input(type="email", name="email", placeholder="you@example.com", required)

                    .form-group.mb-4
                        label.form-label-custom Password
                        input.form-control.custom-input(type="password", name="password", placeholder="Choose a strong password", required)

                    button.btn.custom-btn-yellow.w-100(type="submit") Register

                .text-center.mt-4
                    a(href="/login", style="color: #718096; font-size: 0.8rem; text-decoration: underline;") Already have an account? Login